#!/usr/bin/env bash
set -euo pipefail

# 원격 기기용 GBrain 프록시 — 본체 서버의 동명 래퍼(gbrain-<agent>)를 SSH로 호출한다.
# install.sh <agent>가 본체가 아닌 기기에서 ~/.local/bin/gbrain-<agent> 이름 링크를 만든다.
# 본체 주소는 GBRAIN_HOST로 재정의 가능.

GBRAIN_HOST="${GBRAIN_HOST:-chaconne@49.247.45.243}"

base="$(basename "$0")"
if [[ "$base" == "gbrain-remote-proxy" ]]; then
  agent="${1:?usage: gbrain-remote-proxy <agent> <command> ...}"
  shift
else
  agent="${base#gbrain-}"
fi

# put의 파일은 호출한 서버에 있으므로 SSH 표준입력으로 본체 래퍼에 전달한다.
args=("$@")
offset=0
if [[ "${args[0]:-}" == "--source" ]]; then offset=2; fi
if [[ "${args[$offset]:-}" == "put" ]]; then
  file="${args[$((offset + 2))]:-}"
  if [[ "$file" != "-" ]]; then
    [[ -n "$file" && -f "$file" ]] || { echo "ERROR: file not found: $file" >&2; exit 66; }
    args[$((offset + 2))]="-"
    exec ssh "$GBRAIN_HOST" "/home/chaconne/.local/bin/gbrain-$(printf '%q' "$agent") $(printf '%q ' "${args[@]}")" < "$file"
  fi
fi

exec ssh "$GBRAIN_HOST" "/home/chaconne/.local/bin/gbrain-$(printf '%q' "$agent") $(printf '%q ' "$@")"
