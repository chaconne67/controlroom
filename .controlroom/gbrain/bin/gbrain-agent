#!/usr/bin/env bash
set -euo pipefail

# kmh-agent-kit: 정책 기반 GBrain 공간 래퍼 (에이전트별 사본 스크립트를 대체).
# 등록부는 ~/.gbrain/memory/agent-policy.toml 하나다. 새 에이전트 추가 = 정책 항목 + 카드.
#
# 호출 방법 두 가지 (동작 동일):
#   gbrain-agent <에이전트> <명령> ...
#   gbrain-<에이전트> <명령> ...        # 이름 심링크 (install.sh가 정책에서 자동 생성)
#
# 기본 대상은 자기 공간이다. --source default로 공용을 명시하며 읽기·쓰기 권한은 정책을 따른다.

POLICY_FILE="${GBRAIN_POLICY_FILE:-$HOME/.gbrain/memory/agent-policy.toml}"
GBRAIN_BIN="${GBRAIN_CLI_WRAPPER:-$HOME/.gbrain/bin/gbrain_with_google_env.sh}"

die() { echo "ERROR: $*" >&2; exit 64; }

base="$(basename "$0")"
if [[ "$base" == "gbrain-agent" ]]; then
  agent="${1:-}"
  [[ -n "$agent" ]] || { echo "usage: gbrain-agent <agent> <command> ..." >&2; exit 64; }
  shift
else
  agent="${base#gbrain-}"
fi

[[ "$agent" =~ ^[A-Za-z0-9_-]+$ ]] || die "invalid agent name: $agent"
requested_source=""
if [[ "${1:-}" == "--source" ]]; then
  [[ $# -ge 3 && -n "$2" ]] || die "usage: gbrain-$agent --source <source> <command> ..."
  requested_source="$2"
  shift 2
fi
cmd="${1:-help}"
[[ $# -eq 0 ]] || shift
[[ -f "$POLICY_FILE" ]] || die "policy file not found: $POLICY_FILE"
bun="${BUN_BIN:-$HOME/.bun/bin}/bun"
[[ -x "$bun" ]] || die "Bun runtime not found: $bun"
policy_values="$("$bun" -e '
const [file, agent, requested, command] = process.argv.slice(1);
const policy = Bun.TOML.parse(await Bun.file(file).text());
const entry = policy.agents?.[agent];
if (!entry?.private_source) throw new Error(`unknown or unregistered private source: ${agent}`);
const own = entry.private_source;
const source = requested || own;
if (source !== own && source !== "default") throw new Error(`source outside agent scope: ${source}`);
const reads = (entry.read_sources || []).filter(s => s === "default" || s === own);
if (!reads.includes(source)) throw new Error(`read source not allowed: ${source}`);
const writing = command === "put" || command === "note";
if (writing && !(entry.write_sources || []).includes(source)) throw new Error(`write source not allowed: ${source}`);
if (writing && source === "default" && !(policy.defaults?.common_direct_write && entry.common_write))
  throw new Error("common writing is not allowed by policy");
const prefix = entry.private_prefix || "";
const prefixes = source === "default" ? (policy.guardrails?.common_write_prefixes || []) : (prefix ? [prefix] : []);
if (writing && source === "default" && !prefixes.length) throw new Error("common write prefixes are missing");
if ([own, ...reads, ...prefixes, prefix].some(v => typeof v !== "string" || /\s/.test(v)))
  throw new Error("invalid source or prefix in policy");
console.log([own, source, prefix, (requested ? [source] : reads).join(" "), prefixes.join(" ")].join("\n"));
' "$POLICY_FILE" "$agent" "$requested_source" "$cmd")" || exit 64
mapfile -t policy_fields <<<"$policy_values"
PRIVATE_SOURCE="${policy_fields[0]}"
TARGET_SOURCE="${policy_fields[1]}"
PRIVATE_PREFIX="${policy_fields[2]:-}"
read -r -a READ_SOURCES <<<"${policy_fields[3]}"
read -r -a WRITE_PREFIXES <<<"${policy_fields[4]:-}"

usage() {
  cat <<USAGE
gbrain-$agent — policy-safe GBrain wrapper (default source: '$PRIVATE_SOURCE')

Usage:
  gbrain-$agent [--source default|$PRIVATE_SOURCE] <command> ...
  gbrain-$agent policy
  gbrain-$agent sources
  gbrain-$agent put <slug> <file.md|-> [type]
  gbrain-$agent note <slug-suffix> <markdown text...>
  gbrain-$agent query <query...>          # default + 자기 공간
  gbrain-$agent query-private <query...>
  gbrain-$agent query-all <query...>      # 허용된 공용 + 자기 공간 (query와 동일)
  gbrain-$agent get <slug>
  gbrain-$agent list [--tag <tag>] [-n <1-100>]  # 기본 50건, GBrain 상한 100건

Rules:
  - 사적 쓰기는 소스 '$PRIVATE_SOURCE'${PRIVATE_PREFIX:+의 $PRIVATE_PREFIX/ 아래}에만 저장된다.
  - 공용 조회·저장은 --source default로 명시한다. 저장은 정책에서 허용한 경우에만 가능하다.
  - 다른 에이전트의 개인 공간에는 접근하지 않는다. 검색 실패는 실패 상태로 반환한다.
USAGE
}

require_prefix() {
  local value="$1"
  local prefix
  [[ ${#WRITE_PREFIXES[@]} -eq 0 ]] && return 0
  for prefix in "${WRITE_PREFIXES[@]}"; do
    case "$value" in "$prefix"/*) return 0 ;; esac
  done
  die "slug outside allowed write prefixes for '$TARGET_SOURCE': $value"
}

require_file() { [[ -f "$1" ]] || { echo "ERROR: file not found: $1" >&2; exit 66; }; }

run_query_for_source() {
  local source="$1" query="$2" limit="${3:-5}"
  printf '\n[%s]\n' "$source"
  "$GBRAIN_BIN" query "$query" --source-id "$source" --limit "$limit"
}

case "$cmd" in
  policy)
    exec sed -n "/^\[defaults\]/,/^$/p; /^\[guardrails\]/,/^$/p; /^\[sources\.$PRIVATE_SOURCE\]/,/^$/p; /^\[agents\.$agent\]/,/^$/p" "$POLICY_FILE"
    ;;
  sources)
    exec "$GBRAIN_BIN" sources list
    ;;
  put)
    [[ $# -ge 2 && $# -le 3 ]] || { usage; exit 64; }
    slug="${1:-}"; file="${2:-}"; type="${3:-reference}"
    [[ -n "$slug" && -n "$file" ]] || { usage; exit 64; }
    require_prefix "$slug"
    if [[ "$file" == "-" ]]; then
      exec "$GBRAIN_BIN" capture --source "$TARGET_SOURCE" --slug "$slug" --type "$type" --stdin --json
    fi
    require_file "$file"
    exec "$GBRAIN_BIN" capture --source "$TARGET_SOURCE" --slug "$slug" --type "$type" --file "$file" --json
    ;;
  note)
    suffix="${1:-}"; shift || true
    [[ -n "$suffix" && $# -gt 0 ]] || { usage; exit 64; }
    if [[ "$TARGET_SOURCE" == "$PRIVATE_SOURCE" && -n "$PRIVATE_PREFIX" ]]; then
      case "$suffix" in
        "$PRIVATE_PREFIX"/*) slug="$suffix" ;;
        *) slug="$PRIVATE_PREFIX/$suffix" ;;
      esac
    else
      slug="$suffix"
    fi
    require_prefix "$slug"
    visibility=""
    [[ "$TARGET_SOURCE" != "$PRIVATE_SOURCE" ]] || visibility="visibility: private"
    tmp="$(mktemp)"
    trap 'rm -f "$tmp"' EXIT
    cat > "$tmp" <<EOF
---
page_type: note
agent_id: $agent
logical_source_id: $TARGET_SOURCE
$visibility
---

$*
EOF
    "$GBRAIN_BIN" capture --source "$TARGET_SOURCE" --slug "$slug" --type note --file "$tmp" --json
    ;;
  query|query-all)
    [[ $# -gt 0 ]] || { usage; exit 64; }
    query="$*"
    status=0
    for source in "${READ_SOURCES[@]}"; do
      run_query_for_source "$source" "$query" 5 || status=$?
    done
    exit "$status"
    ;;
  query-private)
    [[ -z "$requested_source" || "$requested_source" == "$PRIVATE_SOURCE" ]] || die "query-private requires the private source"
    [[ $# -gt 0 ]] || { usage; exit 64; }
    exec "$GBRAIN_BIN" query "$*" --source-id "$PRIVATE_SOURCE" --limit 8
    ;;
  get)
    [[ $# -eq 1 ]] || { usage; exit 64; }
    slug="${1:-}"
    [[ -n "$slug" ]] || { usage; exit 64; }
    GBRAIN_SOURCE="$TARGET_SOURCE" exec "$GBRAIN_BIN" get "$slug"
    ;;
  list)
    limit=50; tag=()
    while [[ $# -gt 0 ]]; do
      [[ $# -ge 2 ]] || { usage; exit 64; }
      case "$1" in
        --tag) [[ -n "$2" && "$2" != -* ]] || die "tag is required"; tag=(--tag "$2") ;;
        -n) [[ "$2" =~ ^([1-9]|[1-9][0-9]|100)$ ]] || die "limit must be between 1 and 100"; limit="$2" ;;
        *) die "unsupported list option: $1" ;;
      esac
      shift 2
    done
    GBRAIN_SOURCE="$TARGET_SOURCE" exec "$GBRAIN_BIN" list --limit "$limit" "${tag[@]}"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "ERROR: unknown command: $cmd" >&2
    usage
    exit 64
    ;;
esac
